@page
@model CIDM_3315_Final_Project.Pages.Items.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index (Of Many Things)</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<div class="row" style="margin-bottom: 20px;">
    <form class="d-flex" role="search" asp-page="./Index" method="get">
        <div class="col-3">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control me-2" type="search" name="CurrentSearch" value="@Model.CurrentSearch" placeholder="Search" aria-label="Search">
                <button class="btn btn-outline-success" type="submit">Search</button>
            </div>
        </div>
    </form>
</div>

    <div class="card mb-3">
        <div class="row align-items-center">
            <div class="col-md-2" style="width:128px;height:50px;">
            </div>
            <div class="col-md-10">
                <div class="card-body py-2">
                    <div class ="row align-items-center">
                        <div class="col-md-6">
                            <h5 class="text-start">
                                 @{
                                    //Alternate sort order
                                    var firstSort = "first_asc";
                                    if (Model.CurrentSort == "first_asc")
                                    {
                                        firstSort = "first_desc";
                                    }
                                }
                                    <strong><a asp-page="./Index" asp-route-CurrentSort="@firstSort" asp-route-PageNum="@Model.PageNum">@Html.DisplayNameFor(model => model.Item[0].Name)</a></strong>
                            </h5>
                        </div>
                        <div class="col-md-2">
                            <strong><p class="card-text">@Html.DisplayNameFor(model => model.Item[0].Type)</p></strong>
                        </div>
                        <div class="col-md-2">
                            <strong><p class="card-text">@Html.DisplayNameFor(model => model.Item[0].Rarity)</p></strong>
                        </div>
                        <div class="col-md-2">
                        </div>
                    </div>  
                </div>
            </div>
        </div>
    </div>
@foreach (var item in Model.Item) {
    <div class="card mb-3">
        <div class="row g-0">
            <div class="col-md-2" style="width:128px;height:128px;">
                <img src="@Html.DisplayFor(modelItem => item.ImageURL)" class="img-fluid  h-100 border" object-fit: cover;>
            </div>
            <div class="col-md-10">
                <div class="card-body">
                    <div class ="row">
                        <div class="col-md-6">
                            <h5 class="card-title">@Html.DisplayFor(modelItem => item.Name)</h5>
                            <p class="card-text">@Html.DisplayFor(modelItem => item.Description)</p>
                        </div>
                        <div class="col-md-2">
                            <p class="card-text" class="text-body-secondary">@Html.DisplayFor(modelItem => item.Type.Name)</p>
                        </div>
                        <div class="col-md-2">
                            <p class="card-text" class="text-body-secondary">@Html.DisplayFor(modelItem => item.Rarity.Name)</p>
                        </div>
                        <div class="col-md-2">
                            <p>
                                <a asp-page="./Edit" asp-route-id="@item.ItemID">Edit</a><br />
                                <a asp-page="./Details" asp-route-id="@item.ItemID">Details</a><br />
                                <a asp-page="./Delete" asp-route-id="@item.ItemID">Delete</a>
                            </p>
                        </div>
                    </div>  
                </div>
            </div>
        </div>
    </div>
}
<hr />
@{
    var prevDisabled = "";
    var nextDisabled = "";
    if (Model.PageNum <= 1)
    {
        prevDisabled = "disabled";
    }
    if (Model.PageNum >= Model.TotalPages)
    {
        nextDisabled = "disabled";
    }
}
<nav aria-label="Page navigation example">
    <ul class="pagination">
        <li class="page-item @prevDisabled"><a class="page-link" asp-page="./Index" asp-route-CurrentSort="@Model.CurrentSort" asp-route-PageNum="@(Model.PageNum - 1)">Previous</a></li>
        <li class="page-item @nextDisabled"><a class="page-link" asp-page="./Index" asp-route-CurrentSort="@Model.CurrentSort" asp-route-PageNum="@(Model.PageNum + 1)">Next</a></li>
    </ul>
</nav>